# Template for the scorer's .env. Consumed by docker-compose.scorer.yml.
#
# IMPORTANT: Compose reads `.env` from the directory you run it in (your STACK dir,
# e.g. ~/observability), NOT from this deploy/ folder. So copy this file to
# <stack dir>/.env — not deploy/.env. (deploy/.env is gitignored either way.)

# COMPOSE_FILE makes plain `docker compose` from the stack dir auto-merge the base
# stack + this scorer override, so you never type -f (up/down/restart/run/config).
# Path is relative to the stack dir; assumes this repo is the sibling claude_code_o11y_llm.
COMPOSE_FILE=docker-compose.yml:../claude_code_o11y_llm/deploy/docker-compose.scorer.yml

# Anthropic API key for the LLM judge (score_model_fit.py).
# Required for the real judge; leave blank only if running with SCORER_ARGS=--dry-run.
ANTHROPIC_API_KEY=

# Judge model. Default claude-sonnet-4-6 (right-sized for a rubric judgment, ~1.67x
# cheaper than Opus). PINNED on purpose — the verdict is the score, so upgrade
# deliberately and re-validate (A/B), don't float to "latest". Override here when you do.
JUDGE_MODEL=claude-sonnet-4-6

# Loki endpoints — compose service DNS from inside the stack network. The query
# URL (used by the HTTP fetch + the dedup read) falls back to LOKI_PUSH_URL, so
# you normally only need to set one.
LOKI_PUSH_URL=http://loki:3100
LOKI_QUERY_URL=http://loki:3100

# Flags passed to score_model_fit.py. Set to --dry-run to use the offline
# telemetry stub (no SDK / API key). Leave blank to use the Claude judge.
SCORER_ARGS=

# Pipeline stage toggles (run_scorer.sh). Defaults shown.
#   PROBE=1       read-only Loki connectivity preflight; abort the job if unreachable.
#   FETCH=1       pull raw logs from loki:3100 over HTTP. Set 0 to use a pre-mounted data/raw.
#   SKIP_SCORED=1 drop prompt_ids already in the scores stream (idempotent re-runs).
PROBE=1
FETCH=1
SKIP_SCORED=1
